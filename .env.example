# Cesium Ion access token — https://cesium.com/ion/tokens
VITE_CESIUM_ION_TOKEN=

# Set to true to enable [aviationstack:server] / [globe:client] logs in production builds
# VITE_DEBUG_LOGGING=true

# Aviationstack API access key (required for the primary aircraft source).
# https://aviationstack.com/dashboard
AVIATIONSTACK_ACCESS_KEY=

# Optional Aviationstack overrides. Free-tier accounts may need the HTTP base URL
# (http://api.aviationstack.com/v1/flights); paid plans use HTTPS (the default).
# AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1/flights
# AVIATIONSTACK_LIMIT=100

# Preferred aircraft data provider: "aviationstack" (default) or "adsbfi".
# Whichever is chosen is tried first; the other is used as a fallback when the
# primary is blocked, rate-limited, or returns nothing.
# AIRCRAFT_SOURCE=aviationstack

# adsb.fi fallback coverage. adsb.fi is radius-based (max 250 nm), so by default
# the app fans out across busy regions worldwide for near-global coverage.
# Set BOTH ADSBFI_LAT and ADSBFI_LON to restrict the fallback to a single region
# instead (e.g. 40 / -74 for the US north-east).
# ADSBFI_LAT=
# ADSBFI_LON=
# ADSBFI_DIST=250  # per-query radius in nautical miles (250 is the API maximum)
