# Cesium Ion access token — https://cesium.com/ion/tokens
VITE_CESIUM_ION_TOKEN=

# Set to true to enable [opensky:server] / [globe:client] logs in production builds
# VITE_DEBUG_LOGGING=true

# Preferred aircraft data provider: "opensky" (default) or "adsbfi".
# Whichever is chosen is tried first; the other is used as a fallback when the
# primary is blocked, rate-limited, or returns nothing.
# AIRCRAFT_SOURCE=opensky

# adsb.fi fallback search region (it returns aircraft within a radius, not global).
# Defaults: lat 50, lon 8 (central Europe), 250 nm radius (the API maximum).
# ADSBFI_LAT=50
# ADSBFI_LON=8
# ADSBFI_DIST=250
